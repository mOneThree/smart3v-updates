#!/usr/bin/with-contenv bashio
# ==============================================================================
# Smart 3V Updater
#
# 1. Reads the version list (manifest.json) from the Smart 3V updates repository.
# 2. Downloads any firmware newer than the last one it delivered, and checks its
#    size and SHA-256.
# 3. Puts the file in the Matter Server's "updates" folder and restarts the Matter
#    Server (it only imports update files when it starts).
# 4. Waits for the Matter Server's first update scan, then refreshes the Matter
#    "Firmware" entities so the update shows on each board's page.
#
# Installing an update on a board is always a manual click in Home Assistant.
# Restart this app to check right now.
# ==============================================================================

DEFAULT_MANIFEST="https://raw.githubusercontent.com/mOneThree/smart3v-updates/main/firmware/manifest.json"
STATE_FILE="/data/delivered.json"
PENDING_DIR="/data/pending"

MANIFEST_URL="$(bashio::config 'manifest_url' "${DEFAULT_MANIFEST}")"
[ -z "${MANIFEST_URL}" ] || [ "${MANIFEST_URL}" = "null" ] && MANIFEST_URL="${DEFAULT_MANIFEST}"
MATTER_SLUG="$(bashio::config 'matter_server_slug' 'core_matter_server')"
[ -z "${MATTER_SLUG}" ] || [ "${MATTER_SLUG}" = "null" ] && MATTER_SLUG="core_matter_server"
INTERVAL_MIN="$(bashio::config 'check_interval_minutes' '5')"
RESTART_MODE="$(bashio::config 'restart_matter_server' 'immediately')"
QUIET_TIME="$(bashio::config 'quiet_time' '03:00')"
SCAN_WAIT_MIN="$(bashio::config 'scan_wait_minutes' '11')"
RETRY_WAIT_S="${RETRY_WAIT_S:-30}"     # between Matter Server restart attempts
IMPORT_WAIT_S="${IMPORT_WAIT_S:-300}"  # how long to watch for the import

# Firmware files are only ever downloaded from the folder the version list is in.
BASE_URL="${MANIFEST_URL%/*}"

mkdir -p "${PENDING_DIR}"
[ -f "${STATE_FILE}" ] || echo '{}' > "${STATE_FILE}"

supervisor_api() { # method path
    curl -sS -m 60 -X "$1" -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
        -H "Content-Type: application/json" "http://supervisor$2"
}

core_api() { # method path [json body]
    if [ -n "${3:-}" ]; then
        curl -sS -m 60 -X "$1" -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
            -H "Content-Type: application/json" -d "$3" "http://supervisor/core/api$2"
    else
        curl -sS -m 60 -X "$1" -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
            -H "Content-Type: application/json" "http://supervisor/core/api$2"
    fi
}

# Where the Matter Server's own config folder is mounted inside this app
find_updates_dir() {
    local base
    for base in /addon_configs /app_configs /all_addon_configs /all_app_configs; do
        if [ -d "${base}/${MATTER_SLUG}" ]; then
            echo "${base}/${MATTER_SLUG}/updates"
            return 0
        fi
    done
    base="$(find / -maxdepth 3 -type d -name "${MATTER_SLUG}" -not -path '/proc/*' -not -path '/sys/*' 2>/dev/null | head -n 1)"
    if [ -n "${base}" ]; then
        echo "${base}/updates"
        return 0
    fi
    return 1
}

check_matter_server() {
    local info
    info="$(supervisor_api GET "/addons/${MATTER_SLUG}/info" 2>/dev/null)"
    if [ "$(echo "${info}" | jq -r '.result // empty' 2>/dev/null)" != "ok" ]; then
        bashio::log.warning "Could not read the Matter Server app (${MATTER_SLUG}). Is it installed?"
        return
    fi
    if [ "$(echo "${info}" | jq -r '.data.options.enable_test_net_dcl // false')" != "true" ]; then
        bashio::log.warning "The Matter Server option 'enable_test_net_dcl' is OFF. It ignores custom firmware files until you turn it on:"
        bashio::log.warning "Settings > Apps (Add-ons) > Matter Server > Configuration > enable_test_net_dcl, then restart the Matter Server."
    fi
}

# Current HH:MM in Home Assistant's time zone
local_hhmm() {
    local tz
    tz="$(core_api GET /config 2>/dev/null | jq -r '.time_zone // empty' 2>/dev/null)"
    if [ -n "${tz}" ] && [ -e "/usr/share/zoneinfo/${tz}" ]; then
        TZ="${tz}" date +%H:%M
    else
        date +%H:%M
    fi
}

in_quiet_window() {
    # true during the check interval that starts at QUIET_TIME
    local now_m quiet_m diff
    local hhmm
    hhmm="$(local_hhmm)"
    now_m=$(( 10#${hhmm%%:*} * 60 + 10#${hhmm##*:} ))
    quiet_m=$(( 10#${QUIET_TIME%%:*} * 60 + 10#${QUIET_TIME##*:} ))
    diff=$(( (now_m - quiet_m + 1440) % 1440 ))
    [ "${diff}" -lt "$(( INTERVAL_MIN > 15 ? INTERVAL_MIN : 15 ))" ]
}

remember_delivered() { # key version
    jq --arg k "$1" --argjson v "$2" '.[$k] = $v' "${STATE_FILE}" > "${STATE_FILE}.tmp" &&
        mv "${STATE_FILE}.tmp" "${STATE_FILE}"
}

drop_pending_for() { # key
    local m k
    shopt -s nullglob
    for m in "${PENDING_DIR}"/*.ota.meta; do
        read -r k _ < "${m}"
        if [ "${k}" = "$1" ]; then
            rm -f "${m%.meta}" "${m}"
        fi
    done
    shopt -u nullglob
}

# Lists every Matter firmware entity with its device's maker, model and installed version
BOARDS_TEMPLATE='{% set ns = namespace(out=[]) %}{% for e in integration_entities("matter") | select("match", "^update\\.") %}{% set d = device_id(e) %}{% set ns.out = ns.out + [{"entity": e, "manufacturer": device_attr(d, "manufacturer"), "model": device_attr(d, "model"), "installed": state_attr(e, "installed_version")}] %}{% endfor %}{{ ns.out | tojson }}'

# True (0) only when Home Assistant shows at least one board of this model and all
# of them already run this version. Then there is nothing to hand over, and the
# Matter Server is not restarted. In every other case (no answer, no board found,
# a board on another version) the firmware is delivered as usual.
boards_all_on() { # model version_string
    local boards total behind
    [ -n "$1" ] || return 1
    boards="$(core_api POST /template "$(jq -cn --arg t "${BOARDS_TEMPLATE}" '{template: $t}')" 2>/dev/null)"
    echo "${boards}" | jq -e 'type == "array"' > /dev/null 2>&1 || return 1
    total="$(echo "${boards}" | jq --arg m "$1" '[.[] | select(.model == $m)] | length')"
    behind="$(echo "${boards}" | jq --arg m "$1" --arg v "$2" '[.[] | select(.model == $m and .installed != $v)] | length')"
    if [ "${total}" -gt 0 ] && [ "${behind}" -eq 0 ]; then
        bashio::log.info "All ${total} '$1' board(s) already run $2. Nothing to deliver; the Matter Server is not restarted."
        return 0
    fi
    return 1
}

# Downloads every firmware in the version list that is newer than what was
# delivered before into PENDING_DIR. Prints nothing; returns 0 when done.
fetch_new_firmware() {
    local manifest count i vid pid version vstring file size sha key last tmp got_sha got_size model
    manifest="$(curl -fsSL -m 60 "${MANIFEST_URL}")" || {
        bashio::log.warning "Could not download the version list (${MANIFEST_URL}). Will try again."
        return 1
    }
    if ! echo "${manifest}" | jq -e '.firmware | type == "array"' > /dev/null 2>&1; then
        bashio::log.warning "The version list is not in the expected format. Ignoring it."
        return 1
    fi
    count="$(echo "${manifest}" | jq '.firmware | length')"
    for (( i = 0; i < count; i++ )); do
        vid="$(echo "${manifest}" | jq -r ".firmware[$i].vendor_id")"
        pid="$(echo "${manifest}" | jq -r ".firmware[$i].product_id")"
        version="$(echo "${manifest}" | jq -r ".firmware[$i].version")"
        vstring="$(echo "${manifest}" | jq -r ".firmware[$i].version_string")"
        file="$(echo "${manifest}" | jq -r ".firmware[$i].file")"
        size="$(echo "${manifest}" | jq -r ".firmware[$i].size")"
        sha="$(echo "${manifest}" | jq -r ".firmware[$i].sha256")"

        if ! [[ "${vid}" =~ ^[0-9]+$ && "${pid}" =~ ^[0-9]+$ && "${version}" =~ ^[0-9]+$ && "${size}" =~ ^[0-9]+$ ]] ||
            ! [[ "${file}" =~ ^[A-Za-z0-9._-]+\.ota$ ]] || ! [[ "${sha}" =~ ^[0-9a-f]{64}$ ]]; then
            bashio::log.warning "Skipping an entry in the version list that is not valid."
            continue
        fi

        key="${vid}:${pid}"
        last="$(jq -r --arg k "${key}" '.[$k] // 0' "${STATE_FILE}")"
        if [ "${version}" -le "${last}" ] || [ -f "${PENDING_DIR}/${file}" ]; then
            continue
        fi

        model="$(echo "${manifest}" | jq -r ".firmware[$i] | .model // .name // empty")"
        if boards_all_on "${model}" "${vstring}"; then
            remember_delivered "${key}" "${version}"
            continue
        fi

        # A newer file replaces one still waiting for the quiet time
        drop_pending_for "${key}"

        bashio::log.info "New firmware ${vstring} (version ${version}) for vendor ${vid} / product ${pid}. Downloading ${file}..."
        tmp="${PENDING_DIR}/.download"
        if ! curl -fsSL -m 600 -o "${tmp}" "${BASE_URL}/${file}"; then
            bashio::log.warning "Download failed. Will try again."
            rm -f "${tmp}"
            continue
        fi
        got_size="$(stat -c %s "${tmp}")"
        got_sha="$(sha256sum "${tmp}" | cut -d' ' -f1)"
        if [ "${got_size}" != "${size}" ] || [ "${got_sha}" != "${sha}" ]; then
            bashio::log.error "Downloaded file does not match the version list (size or checksum). It was thrown away."
            rm -f "${tmp}"
            continue
        fi
        mv "${tmp}" "${PENDING_DIR}/${file}"
        echo "${key} ${version} ${vstring}" > "${PENDING_DIR}/${file}.meta"
        bashio::log.info "Downloaded and checked ${file}."
        if [ "${RESTART_MODE}" = "quiet_time" ]; then
            bashio::log.info "It will be handed to the Matter Server at the quiet time (${QUIET_TIME})."
        fi
    done
    return 0
}

refresh_firmware_entities() {
    local entities body
    entities="$(core_api POST /template \
        '{"template":"{{ integration_entities(\"matter\") | select(\"match\", \"^update\\\\.\") | list | tojson }}"}' 2>/dev/null)"
    if ! echo "${entities}" | jq -e 'type == "array" and length > 0' > /dev/null 2>&1; then
        bashio::log.warning "No Matter firmware entities found to refresh (or Home Assistant did not answer)."
        return
    fi
    body="$(jq -cn --argjson e "${entities}" '{entity_id: $e}')"
    core_api POST /services/homeassistant/update_entity "${body}" > /dev/null 2>&1
    bashio::log.info "Refreshed $(echo "${entities}" | jq 'length') Matter firmware entities. New versions now show on each board's Firmware page."
}

# Hands the downloaded files to the Matter Server
deliver_pending() {
    local updates_dir f meta key version vstring result delivered=0
    shopt -s nullglob
    local files=("${PENDING_DIR}"/*.ota)
    shopt -u nullglob
    [ "${#files[@]}" -eq 0 ] && return 0

    if [ "${RESTART_MODE}" = "quiet_time" ] && ! in_quiet_window; then
        return 0 # keep the files until the quiet time
    fi

    if ! updates_dir="$(find_updates_dir)"; then
        bashio::log.error "Could not find the Matter Server's folder. Is the Matter Server app installed and started once?"
        return 1
    fi
    mkdir -p "${updates_dir}"

    for f in "${files[@]}"; do
        meta="$(cat "${f}.meta" 2>/dev/null)"
        cp "${f}" "${updates_dir}/$(basename "${f}")" || {
            bashio::log.error "Could not copy $(basename "${f}") into ${updates_dir}."
            return 1
        }
        delivered=1
    done
    [ "${delivered}" -eq 1 ] || return 0

    bashio::log.info "Restarting the Matter Server so it imports the new firmware. Matter devices are unavailable for about a minute."
    local attempt
    for attempt in 1 2 3; do
        result="$(supervisor_api POST "/addons/${MATTER_SLUG}/restart" 2>/dev/null | jq -r '.result // empty' 2>/dev/null)"
        [ "${result}" = "ok" ] && break
        bashio::log.warning "The Matter Server restart did not go through (try ${attempt} of 3)."
        [ "${attempt}" -lt 3 ] && sleep "${RETRY_WAIT_S}"
    done
    if [ "${result}" != "ok" ]; then
        bashio::log.error "Could not restart the Matter Server. Will try again at the next check. You can also restart it by hand; the files are already in its updates folder."
        return 1
    fi

    # Remember what was delivered, so it is not downloaded again
    for f in "${files[@]}"; do
        read -r key version vstring < "${f}.meta"
        if [ -n "${key}" ] && [[ "${version}" =~ ^[0-9]+$ ]]; then
            remember_delivered "${key}" "${version}"
        fi
        rm -f "${f}" "${f}.meta"
    done

    # The Matter Server removes a file from its updates folder once it has imported it
    local waited=0 left
    while [ "${waited}" -lt "${IMPORT_WAIT_S}" ]; do
        sleep 10
        waited=$(( waited + 10 ))
        left=0
        for f in "${files[@]}"; do
            [ -e "${updates_dir}/$(basename "${f}")" ] && left=1
        done
        [ "${left}" -eq 0 ] && break
    done
    if [ "${left}" -eq 0 ]; then
        bashio::log.info "The Matter Server imported the new firmware."
    else
        bashio::log.warning "The firmware file is still in the Matter Server's updates folder after ${IMPORT_WAIT_S} s, so it was probably not imported."
        bashio::log.warning "Check that 'enable_test_net_dcl' is on and look at the Matter Server log. It will try again the next time the Matter Server starts."
    fi

    bashio::log.info "Waiting ${SCAN_WAIT_MIN} minutes for the Matter Server's update scan..."
    sleep "$(( SCAN_WAIT_MIN * 60 ))"
    refresh_firmware_entities
}

# ------------------------------------------------------------------------------
bashio::log.info "Smart 3V Updater started. Checking ${MANIFEST_URL} every ${INTERVAL_MIN} min; Matter Server restart: ${RESTART_MODE}."
check_matter_server

while true; do
    fetch_new_firmware
    deliver_pending
    sleep "$(( INTERVAL_MIN * 60 ))"
done
